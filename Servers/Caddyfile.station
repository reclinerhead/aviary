# The station's front door (issue #302, epic #212; the porch retired in #666).
#
# Canonical copy lives in the repo at Servers/Caddyfile.station; the live
# copy is /etc/caddy/Caddyfile on the station. Same manual-sync posture as
# orchid's (a reverse-proxy config that deploys itself on merge could take
# every web surface down at once):
#
#     sudo cp ~/aviary/Servers/Caddyfile.station /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
#
# One origin, no names: a station can't assume a local DNS server exists, so
# it answers on :80 whatever the visitor typed -- a bare IP, a router-assigned
# name, or the front door's redirect (aviary.toddtech.llc/<station>, #545).
# Everything is the web app (aviary-web, `next start` on :3000): the Aviary,
# its weather tab, their API routes, /_next assets, /clips. `/` is the app's
# own server-side redirect to /aviary (#628) -- the porch that used to own
# `/` here (Homestead's tile page) retired at the cutover, so there is no
# file_server and no root. The broker's websocket (:9001) is deliberately
# NOT proxied: the browser dials it direct (lib/bus.ts's fallback).
#
# Plain HTTP on the LAN, auto_https off -- the house reasoning travels.

{
	auto_https off
}

:80 {
	# Compression at the choke point (issue #494, same line as orchid's
	# front door): route-handler JSON bypasses Next's compression, and the
	# roster payload is the Aviary's dominant recurring fetch -- paid here
	# over the station's own Wi-Fi link and over every remote tailnet admin
	# session. encode only touches compressible content types; portraits and
	# clips (and their 206 range answers) pass through untouched.
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000
}

# The station Wi-Fi watchdog (issue #686) -- flyway/netwatch.py, one round
# per run. Canonical copy in the repo; the live copy is
# /etc/systemd/system/station-netwatch.service on each station, installed by
# hand (toddtech-infrastructure/servers/Birdhouse.md § The units):
#
#     sudo cp ~/aviary/Servers/station-netwatch.{service,timer} /etc/systemd/system/
#     sudo systemctl daemon-reload && sudo systemctl enable --now station-netwatch.timer
#
# Runs as todd like every station unit. The three root actions (nmcli
# disconnect/connect, the USB unbind/bind writes, reboot) go through sudo -n
# against the exact command lines in Servers/station-netwatch.sudoers -- so
# no NoNewPrivileges= here, it would break sudo.
#
# Deliberately NOT After=/Wants=network-online.target: the watchdog has to
# run precisely when the network is not online.
[Unit]
Description=Station Wi-Fi watchdog -- recover a half-dead stick (issue #686)
After=NetworkManager.service

[Service]
Type=oneshot
User=todd
WorkingDirectory=/home/todd/aviary
EnvironmentFile=/home/todd/station.env
Environment=PYTHONUNBUFFERED=1
# The episode state lives in /run (cleared by a reboot, kept between runs);
# the last-reboot stamp in /var/lib (must survive the reboot it records).
RuntimeDirectory=station-netwatch
RuntimeDirectoryPreserve=yes
StateDirectory=station-netwatch
# A failing DNS lookup can take a while, and rung 1's `nmcli device connect`
# waits up to 90 s for the association.
TimeoutStartSec=5min
ExecStart=/home/todd/aviary/venv/bin/python -m flyway.netwatch

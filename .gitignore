# Python
.venv/
# The boxes' repo venv (~/aviary/venv, #666). Root-anchored, so it can never
# match a nested directory of the same name.
/venv/
__pycache__/
*.pyc
.pytest_cache/

# SQLite stores -- mutable state, never committed: earl.db (the bird record)
# and weather.db (the seasonal weather archive, issue #105). Neither can be
# regenerated -- they are gitignored because they are state, not because they
# are disposable. On every box both live in the checkout root (~/aviary,
# #666), so never run `git clean -x` there: ignored is not protected.
# Backups: toddtech-infrastructure/servers/Orchid.md.
*.db
*.db-wal
*.db-shm

# Willard's rolling 48h window (mutable state beside the stores -- see
# weatherpost/weather.py)
weather_history.json

# Stray images in the checkout root stay out of git (portraits and thumbs
# live under MERLE_EARL_CLIPS, outside the checkout).
*.jpg

# Node / Next.js (web/ has its own .gitignore; this is belt-and-suspenders)
node_modules/
.pnp
.pnp.js
coverage/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.vercel

# Local machine config and secrets
.claude/
.env*

# Agent instructions for this checkout only (Grok Build / project-squirrel-grok).
# Kept out of git so it does not collide with Claude Code (or other) checkouts
# of the same repo that carry their own agent files.
AGENTS.md
